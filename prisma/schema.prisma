// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id          String     @id @default(uuid())
  bedNumber   String
  nickname    String
  dx          String?
  initialNote String?
  createdAt   DateTime   @default(now())
  expiresAt   DateTime?  // For auto-purge

  orders      Order[]
}

model Order {
  id               String     @id @default(uuid())
  patientId        String
  type             String     // "MEDICATION" or "ASSESSMENT"
  name             String
  intervalMinutes  Int?
  startTime        DateTime
  // Server-side push dedup: the due-instance key (see lib/reminders.ts,
  // `${orderId}@${dueTimeMs}`) that a push was already sent for. Prevents the
  // cron check from re-pushing the same due-instance on every run; a new
  // interval produces a new key, so the next due time still alerts.
  lastNotifiedKey  String?

  patient          Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  eventLogs        EventLog[]
}

model EventLog {
  id          String   @id @default(uuid())
  orderId     String
  doneAt      DateTime @default(now())
  // MgSO4 toxicity-monitoring checklist values (RR/urine/DTR), captured only
  // for orders that use that modal — null for every other event type.
  // Previously entered by the nurse and then discarded (audit finding).
  rr          Int?
  urineOutput Int?
  reflex      String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// One browser/device's Web Push subscription. Solo-user app — no owner FK,
// just "every device that has ever enabled notifications". `endpoint` is
// unique per browser install and is how we upsert on re-subscribe.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// ข้อมูลตารางเวรแต่ละวัน
model ShiftSchedule {
  id        String   @id @default(uuid())
  date      String   @unique // "YYYY-MM-DD"
  // เวรของวันนั้นเก็บเป็น "รายเวรย่อย" เพราะสี (ปกติ/OT) แยกอิสระต่อเวรย่อย
  // source of truth ของการคิดเงิน: array เวรย่อย {code, ot}; วันหยุด(OFF) = [] ว่าง
  shifts    Json     // [{ "code":"MORNING","ot":false }, { "code":"AFTERNOON","ot":true }]
  note      String?
  sticker   String?  // "bow", "cherry", "flower", "kitty", "heart"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// การตั้งค่าอัตราเงินเดือนและค่าเวร
model NurseSalaryConfig {
  id                    String   @id @default("default")
  baseSalary            Float    @default(0)    // เงินเดือนพื้นฐาน
  ptsAllowance          Float    @default(0)    // ค่า พ.ต.ส.
  noPrivatePractice     Float    @default(0)    // ค่าไม่ทำเวชฯ / ฉ.11
  inChargeAllowance     Float    @default(0)    // ค่าหัวหน้าเวร
  otherAllowance        Float    @default(0)    // ค่าอื่นๆ
  // --- ค่าเวร (OT): "ตารางเรต" (matrix) เวรย่อย 3 ตัว × สี (normal ดำ / ot แดง) ---
  // shape: { "MORNING":{"normal":0,"ot":0}, "AFTERNOON":{"normal":0,"ot":0}, "NIGHT":{"normal":0,"ot":0} }
  shiftRates            Json
  cycleStartDay         Int      @default(26)   // รอบจ่ายเริ่มวันที่ 26 ของเดือนก่อน → 25 ของเดือนนั้น
  // --- รายการหัก ---
  taxDeduction          Float    @default(0)    // ภาษี ณ ที่จ่าย
  socialSecurity        Float    @default(0)    // ประกันสังคม
  providentFund         Float    @default(0)    // กบข.
  coopDeduction         Float    @default(0)    // สหกรณ์ออมทรัพย์
  otherDeduction        Float    @default(0)    // หักอื่นๆ
  updatedAt             DateTime @updatedAt
}

